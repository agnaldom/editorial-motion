{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@editorial-motion/motion-schema": ["packages/motion-schema/src/index.ts"],
      "@editorial-motion/scene-schema": ["packages/scene-schema/src/index.ts"],
      "@editorial-motion/motion-engine": ["packages/motion-engine/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
