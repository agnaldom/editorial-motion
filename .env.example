NODE_ENV=development
DATABASE_URL=postgresql://editorial:editorial@localhost:5432/editorial_motion
REDIS_URL=redis://localhost:6379
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data
VISION_SERVICE_URL=http://localhost:8000
# Vision providers (none = safe null providers; see apps/vision-service/requirements-ml.txt)
DETECTOR_PROVIDER=none            # none | groundingdino
SEGMENTER_PROVIDER=none           # none | sam2
INPAINT_PROVIDER=copy             # copy | lama | diffusers
VISION_MASK_DIR=./data/masks
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
SAM2_MODEL=facebook/sam2.1-hiera-tiny
DIFFUSERS_INPAINT_MODEL=stabilityai/stable-diffusion-2-inpainting

# OmniRoute: single OpenAI-compatible gateway for OpenAI, Anthropic, and Gemini.
# Model names select the upstream provider, e.g.:
#   openai/gpt-4o | anthropic/claude-sonnet-4 | gemini/gemini-2.5-flash
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=omniroute-local
# Motion planner LLM (any of the 3 providers). Leave empty to use the deterministic double.
MOTION_LLM_MODEL=
# Multimodal model for semantic scene analysis. Defaults to MOTION_LLM_MODEL when empty.
MOTION_VISION_MODEL=
LLM_TIMEOUT_MS=120000

RENDER_DEFAULT_DURATION_SECONDS=8
RENDER_OUTPUT_WIDTH=2560
RENDER_OUTPUT_HEIGHT=1440
RENDER_FPS=30
